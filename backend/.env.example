# auto = Ollama if reachable, then the cloud endpoint, then the template report
LLM_MODE=auto
OLLAMA_URL=http://localhost:11434
# empty = pick the best installed model (llama3.1:8b, qwen2.5:7b, ...)
OLLAMA_MODEL=

# Any OpenAI-compatible endpoint (Groq by default)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=

# Pseudonymise IPs / users / hosts before any model call
LLM_PSEUDONYMIZE=true

# Optional persistence (service-role key: server side only, never in the frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

CORS_ORIGINS=http://localhost:3000
