# Orbit SOC Triage Assistant - Environment Configuration

# LLM Execution Mode:
# auto  = Try local Ollama first, then cloud Groq/OpenAI endpoint, then deterministic template
# local = Use local Ollama only
# cloud = Use cloud API only
# off   = Deterministic template only (no LLM, 100% offline rule-based)
LLM_MODE=auto

# Local Ollama Configuration (defaults to host machine)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=

# Cloud LLM Configuration (Optional: Groq / OpenAI-compatible endpoint)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=

# Security & Data Privacy
LLM_PSEUDONYMIZE=true

# Database Persistence (Optional)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
